    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ほかのアプリのアイコンと大きさがそろうよう、中央を基準に0.86倍に縮める -->
    <group
        android:scaleX="0.86"
        android:scaleY="0.86"
        android:translateX="7.56"
        android:translateY="7.56">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#E0893A"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:pathData="M32,49 V59 M38,43 V65 M44,46 V62 M50,37 V71" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1E1F24"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:pathData="M56,41 V67 M62,39 V69 M68,47 V61 M74,50 V58" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#1E1F24"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:pathData="M53,30 V78" />
    </group>
</vector>

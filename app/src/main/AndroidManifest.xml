<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音楽ファイルの読み取り: Android 12は READ_EXTERNAL_STORAGE、13以降は READ_MEDIA_AUDIO -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- 再生中の通知 (Android 13以降) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KanadeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Kanade">
        <activity
            android:name=".KanadeActivity"
            android:exported="false" />

        <!--
            アプリのアイコンは、アプリ内で切り替えられる (AppIcon.kt)。アイコンごとに入り口 (activity-alias) を置き、
            選んだものだけを有効にする。G (ヘッドホン) の入り口は、前からの入り口の名前 (.MainActivity) のままにして、
            更新してもホーム画面に置いたアイコンが消えないようにする
        -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherE"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_e"
            android:roundIcon="@mipmap/ic_launcher_e"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherH"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_h"
            android:roundIcon="@mipmap/ic_launcher_h"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>

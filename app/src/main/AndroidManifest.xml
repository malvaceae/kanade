<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音楽・動画ファイルの読み取り: Android 12までは READ_EXTERNAL_STORAGE、13以降は READ_MEDIA_AUDIO・READ_MEDIA_VIDEO -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 再生中の通知 (Android 13以降) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".KanadeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Kanade">
        <activity
            android:name=".KanadeActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="false" />

        <!--
            アプリのアイコンは、アプリ内で切り替えられる (AppIcon.kt)。アイコンごとに入り口 (activity-alias) を置き、
            選んだものだけを有効にする。G (ヘッドホン) の入り口は、前からの入り口の名前 (.MainActivity) のままにして、
            更新してもホーム画面に置いたアイコンが消えないようにする。
            DEFAULT は、通知から開くとき (PlaybackService) に、今有効な入り口を探せるようにするためのもの
        -->
        <activity-alias
            android:name=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherE"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_e"
            android:roundIcon="@mipmap/ic_launcher_e"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherH"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_h"
            android:roundIcon="@mipmap/ic_launcher_h"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!--
            ファイラーなどの「このアプリで開く」に出すための入り口 (ACTION_VIEW)。アプリのアイコンの切り替え (上の3つ) とは別で、
            いつも有効にしておく。ランチャーには出さないので、MAINもLAUNCHERも付けない。
            ライブラリに入っていない音声・動画ファイルも、渡されたURIから直接再生する (KanadeActivity.openExternal)。
            file:// は古いファイラー用 (Android 7.0以降は、アプリ間でfile://を渡せない)
        -->
        <activity-alias
            android:name=".OpenMedia"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".KanadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
